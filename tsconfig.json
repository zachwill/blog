{
    "compilerOptions": {
        // Target and environment
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        // Module resolution (Bun-optimized)
        "module": "ESNext",
        "moduleResolution": "bundler",
        // Type checking only (no compilation)
        "noEmit": true,
        // Strict type checking
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        // JSX support
        "jsx": "react-jsx",
        // Path mapping for your aliases
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "content/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}